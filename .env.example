# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# --- Razorpay (Dashboard > Settings > API Keys, use TEST mode keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard > Settings > Webhooks > create webhook > copy the secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Twilio WhatsApp sandbox (console.twilio.com > Messaging > Try it out > WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Optional: lets the agent write more natural nudge messages ---
ANTHROPIC_API_KEY=

# --- App ---
SECRET_KEY=change-me-to-something-random
DATABASE_PATH=recovery.db
# Set this to your ngrok URL (or deployed URL) once you have one, e.g:
# PUBLIC_BASE_URL=https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:5000

MAX_DISCOUNT_PERCENT=10
